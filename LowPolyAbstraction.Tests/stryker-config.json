{
  "stryker-config": {
    "project": "LowPolyAbstraction.csproj",
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "mutate": [
      "**/*.cs",
      "!**/YMM4-GitHubUpdateNotifier/**",
      "!**/YMM4-Telemetry/**",
      "!**/LowPolyAbstractionTelemetry.cs",
      "!**/LowPolyAbstractionUpdateNotifier.cs"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
